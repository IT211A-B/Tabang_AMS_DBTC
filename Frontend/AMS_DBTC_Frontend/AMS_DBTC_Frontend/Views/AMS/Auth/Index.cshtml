<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content="3; url=@Url.Action("login", "Auth")" />
    <title>EduAttend — Loading</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800;900&family=Nunito+Sans:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/loading.css" />
</head>

<body>
    <div class="bg-circles">
        <div class="bg-circle"></div>
        <div class="bg-circle"></div>
        <div class="bg-circle"></div>
        <div class="bg-circle"></div>
    </div>

    <!-- Main loading card -->
    <div class="loader-card" id="loaderCard">

        <!-- School Logo -->
        <div class="loader-icon">
            <img src="@Url.Content("~/css/assets/donboscologo.jpg")" />
        </div>

        <!-- Brand -->
        <div class="loader-name"> DBTC ATTENDANCE</div>
        <div class="loader-tagline">Attendance Management System</div>

        <!-- Animated dots -->
        <div class="loader-dots">
            <div class="dot"></div>
            <div class="dot"></div>
            <div class="dot"></div>
        </div>

        <!-- Status message -->
        <div class="loader-status" id="loaderStatus">Loading, please wait…</div>
    </div>
</body>
</html>